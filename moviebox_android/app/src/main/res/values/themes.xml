<resources>
    <!-- Base application theme -->
    <style name="Theme.CineScope" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent_red</item>
        <item name="colorPrimaryVariant">@color/accent_red</item>
        <item name="colorOnPrimary">@color/text_primary</item>
        <item name="colorSurface">@color/card_bg</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/nav_bg</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Splash — fullscreen, no status bar flicker -->
    <style name="Theme.CineScope.Splash" parent="Theme.CineScope">
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowBackground">@color/splash_bg</item>
        <item name="android:statusBarColor">@color/splash_bg</item>
    </style>

    <!-- Nav item colors selector -->
    <style name="BottomNav" parent="Widget.MaterialComponents.BottomNavigationView">
        <item name="itemIconTint">@color/nav_item_color</item>
        <item name="itemTextColor">@color/nav_item_color</item>
    </style>
</resources>
